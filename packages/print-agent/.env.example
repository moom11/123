# MARA print agent — runs inside the branch network.
# Create the token in the system: Printers → "وكيل طباعة جديد".

MARA_API_URL=https://api.maralounge.sa
MARA_AGENT_TOKEN=

# Polling and health
MARA_POLL_MS=2000
MARA_HEARTBEAT_MS=30000
MARA_PRINTER_TIMEOUT_MS=5000
MARA_BATCH_SIZE=10

# Set true to exercise the whole loop without consuming paper.
MARA_DRY_RUN=false
