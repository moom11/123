[Unit]
Description=نظام الموارد البشرية - الحضور والإجازات
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hr
Group=hr
WorkingDirectory=/opt/hr
Environment="PYTHONPATH=/opt/hr/backend"
Environment="HR_DATA_DIR=/opt/hr/data"
Environment="HR_TIMEZONE=Asia/Riyadh"
# اضبط القيم الحساسة في /etc/hr.env (المفتاح وكلمة مرور المدير)
EnvironmentFile=-/etc/hr.env
ExecStart=/opt/hr/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/hr/data

[Install]
WantedBy=multi-user.target
