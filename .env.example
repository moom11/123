# انسخ هذا الملف إلى .env قبل تشغيل docker compose
# مفتاح توقيع الجلسات - ولّده بأمر: openssl rand -hex 32
HR_SECRET_KEY=change-me-to-a-random-64-char-hex
# كلمة مرور مدير النظام الأولى (تُستخدم عند أول تشغيل فقط)
HR_ADMIN_PASSWORD=change-me
# المزامنة التلقائية لأجهزة وضع السحب بالدقائق (0 = معطّلة)
HR_AUTO_SYNC_MINUTES=0
