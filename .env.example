# ─── MARA Lounge Management System — environment ────────────────────────────
# Copy to .env and fill in. NOTHING here is ever shipped to a browser.

NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgres://mara:CHANGE_ME@localhost:5432/mara
DB_POOL_MAX=10
DB_SSL=false

# --- Secrets (min 32 chars each; generate with `openssl rand -base64 48`) ----
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=
MFA_SECRET_KEY=

# --- Sessions ---------------------------------------------------------------
ACCESS_TTL_SECONDS=900
ADMIN_REFRESH_TTL_SECONDS=43200
EMPLOYEE_REFRESH_TTL_SECONDS=50400
CUSTOMER_REFRESH_TTL_SECONDS=2592000
ADMIN_IDLE_TIMEOUT_SECONDS=1800
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
MAX_FAILED_PINS=5
PIN_LOCKOUT_MINUTES=10
# Must stay true in production: administrative roles require MFA.
REQUIRE_ADMIN_MFA=true
MFA_ISSUER=MARA Lounge

# --- WhatsApp OTP (Meta WhatsApp Business Platform) -------------------------
# 'log' prints codes to the server log and REFUSES to run in production.
WHATSAPP_PROVIDER=meta_cloud
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_OTP_TEMPLATE=mara_otp
WHATSAPP_TEMPLATE_LANGUAGE=ar

OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_PHONE_PER_HOUR=8

# --- Printing ---------------------------------------------------------------
PRINT_LEASE_SECONDS=60
PRINT_RETRY_BACKOFF_SECONDS=15
PRINT_MAX_ATTEMPTS=5
PRINT_AGENT_OFFLINE_SECONDS=120

# --- Inventory thresholds ---------------------------------------------------
VARIANCE_ALERT_PERCENT=3
VARIANCE_ALERT_VALUE=20000
WASTE_APPROVAL_THRESHOLD=10000

# --- Web ---------------------------------------------------------------------
CORS_ORIGINS=https://pos.maralounge.sa,https://menu.maralounge.sa
PUBLIC_MENU_BASE_URL=https://menu.maralounge.sa
TRUST_PROXY=true
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=8388608

# --- Seed (first run only) --------------------------------------------------
SEED_OWNER_PASSWORD=
SEED_MANAGER_PASSWORD=
